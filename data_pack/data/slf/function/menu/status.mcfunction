# Status sheet. Runs as the player.
execute unless entity @s[tag=slf.class_chosen] run return run function slf:class/select
function slf:player/init_scores
tellraw @s ["",{"text":"━━━ ","color":"dark_gray"},{"text":"Status","color":"gold","bold":true},{"text":" ━━━","color":"dark_gray"}]
function slf:class/name
tellraw @s ["",{"text":" Level ","color":"gray"},{"score":{"name":"@s","objective":"slf.level"},"color":"white"},{"text":"   EXP ","color":"gray"},{"score":{"name":"@s","objective":"slf.exp"},"color":"white"},{"text":"/","color":"dark_gray"},{"score":{"name":"@s","objective":"slf.exp_next"},"color":"white"},{"text":"   Unspent points ","color":"gray"},{"score":{"name":"@s","objective":"slf.sp_points"},"color":"yellow"}]
tellraw @s ["",{"text":" HP ","color":"dark_red"},{"score":{"name":"@s","objective":"slf.stat.hp"}},{"text":"  MP ","color":"blue"},{"score":{"name":"@s","objective":"slf.stat.mp"}},{"text":"  STR ","color":"red"},{"score":{"name":"@s","objective":"slf.stat.str"}},{"text":"  DEX ","color":"yellow"},{"score":{"name":"@s","objective":"slf.stat.dex"}},{"text":"  VIT ","color":"green"},{"score":{"name":"@s","objective":"slf.stat.vit"}}]
tellraw @s ["",{"text":" AGI ","color":"aqua"},{"score":{"name":"@s","objective":"slf.stat.agi"}},{"text":"  TEC ","color":"light_purple"},{"score":{"name":"@s","objective":"slf.stat.tec"}},{"text":"  LUC ","color":"gold"},{"score":{"name":"@s","objective":"slf.stat.lck"}},{"text":"  STM ","color":"white"},{"score":{"name":"@s","objective":"slf.stat.stm"}},{"text":"   Mana ","color":"blue"},{"score":{"name":"@s","objective":"slf.mana"}},{"text":"/","color":"dark_gray"},{"score":{"name":"@s","objective":"slf.mana_max"}}]
tellraw @s ["",{"text":" Mahni ","color":"gold"},{"score":{"name":"@s","objective":"slf.mahni"},"color":"yellow"}]
execute if score @s slf.focus matches 1.. run tellraw @s ["",{"text":" Skill focus progress: ","color":"gray"},{"score":{"name":"@s","objective":"slf.sp"},"color":"white"},{"text":"/","color":"dark_gray"},{"score":{"name":"@s","objective":"slf.threshold"},"color":"white"}]
execute if score @s slf.standby matches 1 run tellraw @s {"text":" Standby: level 99 reached. EXP is being banked for the Altar of Awakening.","color":"light_purple"}
tellraw @s ["",{"text":"[Back]","color":"dark_gray","click_event":{"action":"run_command","command":"trigger slf.menu set 1"},"hover_event":{"action":"show_text","value":"Main menu"}}]
