# Main menu. Open with /trigger slf.menu
tellraw @s ["",{"text":"━━━ ","color":"dark_gray"},{"text":"Shangri-La Frontier","color":"gold","bold":true},{"text":" ━━━","color":"dark_gray"}]
execute unless entity @s[tag=slf.class_chosen] run tellraw @s ["",{"text":" "},{"text":"[Choose your class]","color":"aqua","click_event":{"action":"run_command","command":"trigger slf.menu set 2"},"hover_event":{"action":"show_text","value":"Pick one of the 8 starting classes"}}]
execute if entity @s[tag=slf.class_chosen] run tellraw @s ["",{"text":" "},{"text":"[Status]","color":"white","click_event":{"action":"run_command","command":"trigger slf.menu set 7"},"hover_event":{"action":"show_text","value":"Class, level and stats"}},{"text":"  "},{"text":"[Stats]","color":"green","click_event":{"action":"run_command","command":"trigger slf.menu set 4"},"hover_event":{"action":"show_text","value":"Spend stat points"}},{"text":"  "},{"text":"[Skills]","color":"aqua","click_event":{"action":"run_command","command":"trigger slf.menu set 3"},"hover_event":{"action":"show_text","value":"Choose a skill to focus"}},{"text":"  "},{"text":"[Evolve]","color":"gold","click_event":{"action":"run_command","command":"trigger slf.menu set 5"},"hover_event":{"action":"show_text","value":"Class evolution"}}]
execute if entity @s[tag=slf.skill.big_tantrum] run tellraw @s ["",{"text":" "},{"text":"[Big Tantrum]","color":"red","click_event":{"action":"run_command","command":"trigger slf.menu set 8"},"hover_event":{"action":"show_text","value":"Toggle Big Tantrum (drains mana while active)"}}]
execute if entity @s[tag=!slf.skill.big_tantrum,tag=slf.skill.grand_tantrum] run tellraw @s ["",{"text":" "},{"text":"[Grand Tantrum]","color":"red","click_event":{"action":"run_command","command":"trigger slf.menu set 8"},"hover_event":{"action":"show_text","value":"Toggle Grand Tantrum (drains mana while active)"}}]
execute if score @s slf.standby matches 1 run tellraw @s ["",{"text":" "},{"text":"[Altar of Awakening]","color":"light_purple","click_event":{"action":"run_command","command":"trigger slf.menu set 6"},"hover_event":{"action":"show_text","value":"Where to go to break the level 99 limit"}}]
execute if entity @s[tag=slf.class_chosen] run tellraw @s ["",{"text":" "},{"text":"[Quests]","color":"gold","click_event":{"action":"run_command","command":"trigger slf.menu set 10"},"hover_event":{"action":"show_text","value":"Your quest log"}}]
execute if entity @s[tag=slf.class_chosen] run tellraw @s ["",{"text":" "},{"text":"[HUD on/off]","color":"dark_gray","click_event":{"action":"run_command","command":"trigger slf.menu set 9"},"hover_event":{"action":"show_text","value":"Show or hide the status line above the hotbar"}}]
