# The quest log (/trigger slf.menu set 10): every quest the player has started.
function slf:player/init_scores
tellraw @s ["",{"text":"━━━ ","color":"dark_gray"},{"text":"Quests","color":"gold","bold":true},{"text":" ━━━","color":"dark_gray"}]
execute if score @s slf.q.awaken matches 0 if score @s slf.q.outskirts matches 0 if score @s slf.q.herd matches 0 run tellraw @s {"text":" No quests yet. Talk to the people of Firstia: the Town Elder, the Guard Captain and the Distressed Farmer.","color":"gray"}
execute if score @s slf.q.herd matches 1 run tellraw @s ["",{"text":" The Missing Herd: ","color":"gold"},{"text":"daughter ","color":"yellow"},{"text":"(talk to her at the camp)","color":"gray"},{"text":", cows home ","color":"yellow"},{"score":{"name":"@s","objective":"slf.q.cows"},"color":"white"},{"text":"/3","color":"yellow"}]
execute if score @s slf.q.herd matches 2 run tellraw @s ["",{"text":" The Missing Herd: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.serpent matches 1 run tellraw @s ["",{"text":" The Serpent's Shadow: ","color":"gold"},{"text":"speak with the Guard Captain","color":"yellow"}]
execute if score @s slf.q.serpent matches 2 run tellraw @s ["",{"text":" The Serpent's Shadow: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.guardian matches 1 if score @s slf.q.snake matches 0 run tellraw @s ["",{"text":" The Rampant Forest Guardian: ","color":"gold"},{"text":"defeat the Ravenous Snake","color":"yellow"}]
execute if score @s slf.q.guardian matches 1 if score @s slf.q.snake matches 1 run tellraw @s ["",{"text":" The Rampant Forest Guardian: ","color":"gold"},{"text":"report to the Guard Captain","color":"yellow"}]
execute if score @s slf.q.guardian matches 2 run tellraw @s ["",{"text":" The Rampant Forest Guardian: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.delivery matches 1 run tellraw @s ["",{"text":" Secondil Supply Delivery: ","color":"gold"},{"text":"deliver the beef to Garren in Secondil","color":"yellow"}]
execute if score @s slf.q.delivery matches 2 run tellraw @s ["",{"text":" Secondil Supply Delivery: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.bed matches 1 run tellraw @s ["",{"text":" A Soft Bed at Last: ","color":"gold"},{"text":"lie in a bed to register your respawn","color":"yellow"}]
execute if score @s slf.q.bed matches 2 run tellraw @s ["",{"text":" A Soft Bed at Last: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.antidote matches 1 run tellraw @s ["",{"text":" Antidote Run: ","color":"gold"},{"text":"deliver 3 Antidote Bundles to Innkeeper Marrow","color":"yellow"}]
execute if score @s slf.q.antidote matches 2 run tellraw @s ["",{"text":" Antidote Run: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.watch matches 1 run tellraw @s ["",{"text":" The Night Watch: ","color":"gold"},{"text":"at night, stand watch near Guard Halvor ","color":"yellow"},{"score":{"name":"@s","objective":"slf.q.watch_t"},"color":"white"},{"text":"/45 s","color":"yellow"}]
execute if score @s slf.q.watch matches 2 run tellraw @s ["",{"text":" The Night Watch: ","color":"gold"},{"text":"report to Guard Halvor","color":"yellow"}]
execute if score @s slf.q.watch matches 3 run tellraw @s ["",{"text":" The Night Watch: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.bar matches 1..3 run tellraw @s ["",{"text":" Bar Talk: ","color":"gold"},{"text":"Old Borric's stories heard: ","color":"yellow"},{"score":{"name":"@s","objective":"slf.q.bar"},"color":"white"},{"text":" (talk to him; 3 needed)","color":"yellow"}]
execute if score @s slf.q.bar matches 4 run tellraw @s ["",{"text":" Bar Talk: ","color":"gold"},{"text":"tell the Bartender if the marsh story is true","color":"yellow"}]
execute if score @s slf.q.bar matches 5 run tellraw @s ["",{"text":" Bar Talk: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.pickaxe matches 1 run tellraw @s ["",{"text":" The Iron Pickaxe: ","color":"gold"},{"text":"bring Garren 5 raw iron from the Diremarsh","color":"yellow"}]
execute if score @s slf.q.pickaxe matches 2 run tellraw @s ["",{"text":" The Iron Pickaxe: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.splitblade matches 1 run tellraw @s ["",{"text":" Splitblade Set: ","color":"gold"},{"text":"bring Garren 4 Mud Frog Skins","color":"yellow"}]
execute if score @s slf.q.splitblade matches 2 run tellraw @s ["",{"text":" Splitblade Set: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.miner matches 1 run tellraw @s ["",{"text":" The Missing Miner: ","color":"gold"},{"text":"search Tomic's dig site (coordinates were in chat)","color":"yellow"}]
execute if score @s slf.q.miner matches 2 run tellraw @s ["",{"text":" The Missing Miner: ","color":"gold"},{"text":"take Tomic's journal to Garren","color":"yellow"}]
execute if score @s slf.q.miner matches 3 run tellraw @s ["",{"text":" The Missing Miner: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.reeds matches 1 run tellraw @s ["",{"text":" Red Hoods in the Reeds: ","color":"gold"},{"text":"show Tomic's journal to Guard Halvor","color":"yellow"}]
execute if score @s slf.q.reeds matches 2 run tellraw @s ["",{"text":" Red Hoods in the Reeds: ","color":"gold"},{"text":"talk to Halvor at night to lead the patrol","color":"yellow"}]
execute if score @s slf.q.reeds matches 3 run tellraw @s ["",{"text":" Red Hoods in the Reeds: ","color":"gold"},{"text":"clear the Redcap camp, bring its banner to Halvor","color":"yellow"}]
execute if score @s slf.q.reeds matches 4 run tellraw @s ["",{"text":" Red Hoods in the Reeds: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.thirdrema matches 1 run tellraw @s ["",{"text":" Path to Thirdrema: ","color":"gold"},{"text":"defeat the Mud Digger","color":"yellow"}]
execute if score @s slf.q.thirdrema matches 2 run tellraw @s ["",{"text":" Path to Thirdrema: ","color":"gold"},{"text":"report to Garren","color":"yellow"}]
execute if score @s slf.q.thirdrema matches 3 run tellraw @s ["",{"text":" Path to Thirdrema: ","color":"gold"},{"text":"complete","color":"green"}]
execute if entity @s[tag=slf.wandering] run tellraw @s ["",{"text":" The Wanderer's Path: ","color":"dark_red"},{"text":"survive the forest, kill the Ravenous Snake, sleep at Secondil's inn. Don't die.","color":"red"}]
execute if entity @s[tag=slf.first_survivor] run tellraw @s ["",{"text":" First Survivor","color":"gold","bold":true}]
execute if score @s slf.q.letter matches 1 run tellraw @s ["",{"text":" A Brother's Letter: ","color":"gold"},{"text":"give the letter to Garren in Secondil","color":"yellow"}]
execute if score @s slf.q.letter matches 2 run tellraw @s ["",{"text":" A Brother's Letter: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.awaken matches 1 run tellraw @s ["",{"text":" A Pioneer's Awakening: ","color":"gold"},{"text":"speak with the Local Alchemist","color":"yellow"}]
execute if score @s slf.q.awaken matches 2 run tellraw @s ["",{"text":" A Pioneer's Awakening: ","color":"gold"},{"text":"bring 5 Wild Herbs to the Town Elder","color":"yellow"}]
execute if score @s slf.q.awaken matches 3 run tellraw @s ["",{"text":" A Pioneer's Awakening: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.outskirts matches 1 run tellraw @s ["",{"text":" Clearing the Outskirts: ","color":"gold"},{"text":"Goblins ","color":"yellow"},{"score":{"name":"@s","objective":"slf.q.goblins"},"color":"white"},{"text":"/5, then the Guard Captain","color":"yellow"}]
execute if score @s slf.q.outskirts matches 2 run tellraw @s ["",{"text":" Clearing the Outskirts: ","color":"gold"},{"text":"complete","color":"green"}]
execute if score @s slf.q.brute matches 1 run tellraw @s ["",{"text":" The Brute Threat: ","color":"gold"},{"text":"Orcs ","color":"yellow"},{"score":{"name":"@s","objective":"slf.q.orcs"},"color":"white"},{"text":"/2, then the Guard Captain","color":"yellow"}]
execute if score @s slf.q.brute matches 2 run tellraw @s ["",{"text":" The Brute Threat: ","color":"gold"},{"text":"complete","color":"green"}]
tellraw @s ["",{"text":"[Back]","color":"dark_gray","bold":true,"click_event":{"action":"run_command","command":"/trigger slf.menu set 1"},"hover_event":{"action":"show_text","value":"Main menu"}}]
