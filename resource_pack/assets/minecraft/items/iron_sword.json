{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {"when": "slf.wethermon_rib_dagger", "model": {"type": "minecraft:model", "model": "slf:item/wethermon_rib_dagger"}},
      {"when": "slf.sunraku_blade_r",      "model": {"type": "minecraft:model", "model": "slf:item/sunraku_blade_r"}},
      {"when": "slf.sunraku_blade_l",      "model": {"type": "minecraft:model", "model": "slf:item/sunraku_blade_l"}}
    ],
    "fallback": {"type": "minecraft:model", "model": "minecraft:item/iron_sword"}
  }
}
