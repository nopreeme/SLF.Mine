{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "slf.wethermon_katana",
        "model": {
          "type": "minecraft:model",
          "model": "slf:item/wethermon_katana"
        }
      },
      {
        "when": "slf.crescent_blade",
        "model": {
          "type": "minecraft:model",
          "model": "slf:item/crescent_blade"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/netherite_sword"
    }
  }
}
